FROM node:22-alpine AS build

WORKDIR /srv/motionQa

# Empty values make the UI call the API on its own origin (nginx proxies /api and /ws).
ARG VITE_API_BASE_URL=""
ARG VITE_WS_BASE_URL=""
ARG VITE_LINE_ID="LINE_01"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_BASE_URL=$VITE_WS_BASE_URL
ENV VITE_LINE_ID=$VITE_LINE_ID

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html viteConfig.ts tailwindConfig.ts tsconfig.json ./
COPY src ./src

RUN npm run build

FROM nginx:1.27-alpine
COPY nginxConfig.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/motionQa/dist /usr/share/nginx/html
EXPOSE 80
